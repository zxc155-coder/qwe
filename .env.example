# Telegram bot token from @BotFather
BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram numeric user-id of the shop admin (only this id can use /admin)
ADMIN_ID=8417505079

# Public URL of the Web App (set after starting ngrok / cloudflared)
# Example: https://abcd-1234.ngrok.app
WEB_APP_URL=

# Port for the local Express REST API used by the Web App
API_PORT=3001

# Path to the SQLite database file (created automatically)
DB_PATH=./db/vibe_cloud.sqlite
